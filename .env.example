# ─── Database ─────────────────────────────────────────────────────────────────
# Async SQLAlchemy URL using asyncpg (required by FastAPI backend)
DATABASE_URL=postgresql+asyncpg://jobagent:jobagent@localhost:5432/jobagent
# Sync SQLAlchemy URL using psycopg2 (required by Alembic migrations)
DATABASE_URL_SYNC=postgresql://jobagent:jobagent@localhost:5432/jobagent

POSTGRES_USER=jobagent
POSTGRES_PASSWORD=jobagent
POSTGRES_DB=jobagent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY_64_CHARS
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Supported: anthropic, openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
OPENAI_API_KEY=sk-REPLACE_ME

# LLM model identifiers
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_MODEL=gpt-4o

# ─── Discovery ────────────────────────────────────────────────────────────────
BSM_BASE_URL=https://www.bangalorestartupmap.com
CRAWL_RATE_LIMIT_RPS=1.0
CRAWL_MAX_RETRIES=3
CRAWL_TIMEOUT_SECONDS=30

# ─── File storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./candidate_data
MAX_UPLOAD_SIZE_MB=50

# ─── LaTeX compilation ────────────────────────────────────────────────────────
LATEX_COMPILER=pdflatex
LATEX_MAX_COMPILE_ATTEMPTS=3

# ─── Celery / Task queue ──────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
